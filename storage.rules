rules_version = '2';

// Cloud Storage security rules.
//
// F-3 (audit/OVERNIGHT_DATA_LIFECYCLE_AUDIT.md §2.3, P1). The previous version
// of this file was:
//
//   match /users/{userId}/{allPaths=**} {
//     allow read: if request.auth != null;
//     allow write: if request.auth != null && request.auth.uid == userId
//                  && request.resource.size < 10 * 1024 * 1024
//                  && request.resource.contentType.matches('image/.*');
//   }
//
// Two defects in four lines:
//
//  1. `write` covers create, update AND delete — but on a DELETE
//     `request.resource` is null, so `request.resource.size` fails to evaluate
//     and the delete is denied. Always. For the owner. That is why
//     `deleteHousePhoto()` (image_upload_service.dart:88) always returned
//     false, and it did so silently, because it catches and returns rather
//     than throwing. The house photo was, by rule, undeletable by the person
//     in the photograph's driveway.
//
//  2. `allow read: if request.auth != null` let ANY authenticated Lumina
//     account — including an anonymous staff-PIN session — read ANY user's
//     house photo by guessing nothing more than a uid.
//
// Both are fixed below: the resource-shape conditions now sit on
// `create, update` only, `delete` gets its own owner-only clause, and `read`
// is owner-scoped.
//
// WHY NARROWING `read` DOES NOT BREAK THE MEDIA/INSTALLER DASHBOARD.
// media_dashboard_screen.dart:409 renders another user's house photo, which
// looks like a cross-account read. It is not one: every render site in the app
// goes through `Image.network(user.housePhotoUrl)`, and `housePhotoUrl` is the
// value `getDownloadURL()` returned at upload time — a tokenised HTTPS URL
// that is served WITHOUT evaluating these rules. The only method that would
// have needed a rules-gated cross-account read is
// `ImageUploadService.getHousePhotoUrl()`, and it has zero callers (verified
// 2026-08-26). So nothing in the shipped app loses access.
//
// Corollary, stated so it is not mistaken for more than it is: because
// download URLs bypass rules, this change does not revoke a URL that has
// already leaked. What it closes is path enumeration — any signed-in account
// walking `users/{uid}/house_photo.jpg` for uids it does not own.

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // A user's own folder: house photo today, whatever else lands here later.
    match /users/{userId}/{allPaths=**} {

      // Owner only. See the note above on download URLs.
      allow read: if isOwner(userId);

      // Uploads and replacements carry a body, so the size/type guards apply.
      allow create, update: if isOwner(userId)
                            && request.resource.size < 10 * 1024 * 1024  // 10MB
                            && request.resource.contentType.matches('image/.*');

      // Deletes carry NO body — `request.resource` is null here, so the two
      // conditions above must not be repeated or this clause is dead again.
      // Ownership is the whole test, and it is the right one: account deletion
      // (AccountDeletionService) calls deleteHousePhoto() before the
      // purgeUserAccount callable sweeps the prefix server-side.
      allow delete: if isOwner(userId);
    }

    // ── Sales pipeline artefacts (2026-11-17) ─────────────────────────────
    //
    // The customer e-signature PNG and the prospect / zone / wizard / day-1
    // photos live under sales_jobs/{jobId}/**; the Day-2 install-complete
    // photos under sales/{jobId}/install_complete/{runId}.jpg. No rule ever
    // matched either prefix, so default-deny refused every one of the six
    // putData() sites in lib/features/sales — the signature step could never
    // complete for anyone.
    //
    // WHO: staff PIN sessions only (mintStaffToken claims). Sales and
    // installer claims are scoped to the job's dealer through the job
    // document; admin and owner claims are corporate and reach every job,
    // as they do in firestore.rules. Customer and anonymous sessions get
    // nothing here — the app renders these images through the tokenised
    // download URL it stored on the job, which is served without rules.
    //
    // CROSS-SERVICE BUDGET: Storage rules may make at most 2
    // firestore.exists()/get() calls per request. isStaffOfJob() makes
    // exactly two, on the same job document, and only for a sales/installer
    // claim; admin/owner short-circuit with none. No user-doc lookups.
    //
    // PRE-SAVE DRAFTS: prospect_info_screen.dart uploads photos under a job
    // id that _ensureDraftJob() has generated but not yet written, and every
    // upload site calls getDownloadURL() (a rules-gated READ) right after.
    // So while the job document does not exist, any sales/installer claim may
    // write and read under that id. Ids are random Firestore auto-ids and the
    // moment the job lands, dealer scoping applies. Same residual shape as
    // staffMayReach() in firestore.rules.
    //
    // DEPLOY NOTE: firestore.* calls need the storage service agent to hold
    // roles/firebaserules.firestoreServiceAgent. The CLI offers that grant
    // only on an INTERACTIVE deploy (it skips the check under
    // --non-interactive), and neither project holds it today. Without it
    // every staff branch below fails closed.

    function isCorporateClaim() {
      return request.auth != null
          && request.auth.token.get('role', '') in ['admin', 'owner'];
    }

    function isScopedStaffClaim() {
      return request.auth != null
          && request.auth.token.get('dealerCode', '') != ''
          && request.auth.token.get('role', '') in ['salesperson', 'installer'];
    }

    function isStaffOfJob(jobId) {
      return isScopedStaffClaim() && (
        !firestore.exists(/databases/(default)/documents/sales_jobs/$(jobId))
        || firestore.get(/databases/(default)/documents/sales_jobs/$(jobId))
             .data.get('dealerCode', '') == request.auth.token.get('dealerCode', ''));
    }

    function mayHandleSalesArtefact(jobId) {
      return isCorporateClaim() || isStaffOfJob(jobId);
    }

    function isImageUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    match /sales_jobs/{jobId}/{allPaths=**} {
      allow read: if mayHandleSalesArtefact(jobId);
      // Create only: every writer under this prefix names its object with a
      // fresh timestamp, so a re-sign or re-shoot is a NEW object and the
      // signature bytes are never overwritten. `resource == null` is stated
      // because the Storage emulator evaluates an overwrite as a create
      // (production calls it an update); this keeps both immutable.
      allow create: if mayHandleSalesArtefact(jobId)
                    && isImageUnder10MB()
                    && resource == null;
      allow update, delete: if false;
    }

    match /sales/{jobId}/{allPaths=**} {
      allow read: if mayHandleSalesArtefact(jobId);
      // Create AND update: day2_wrap_up_screen.dart writes
      // install_complete/{runId}.jpg — a deterministic name — so re-shooting
      // a channel's photo overwrites it. No delete from the client.
      allow create, update: if mayHandleSalesArtefact(jobId) && isImageUnder10MB();
      allow delete: if false;
    }
  }
}
