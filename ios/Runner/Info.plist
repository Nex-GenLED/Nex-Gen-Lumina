<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Lumina</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Lumina</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
    <!-- Portrait only, iPhone only (TARGETED_DEVICE_FAMILY = 1). No screen
         has a landscape layout, and there is no tablet layout. The
         UISupportedInterfaceOrientations~ipad list was removed with the iPad
         slice: an iPhone-only app runs on iPad in compatibility mode and uses
         this list. Adding iPad back later means real tablet layouts AND 13"
         screenshots; App Store Connect will not let a later version drop a
         device family once a version has shipped with it. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSBonjourServices</key>
	<array>
		<string>_wled._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Lumina scans your local network to find and control your Nex-Gen lighting controllers.</string>
    <!-- Location usage, as shipped: (1) iOS requires it to read the Wi-Fi
         network name (connectivity_service.dart getCurrentSsid), which
         decides home vs away and pre-fills Bluetooth controller setup;
         (2) a one-shot low-accuracy fix written into the controller's clock
         settings so sunrise/sunset timers fire at the right time
         (controller_defaults_healer.dart _resolvePhonePositionIfPermitted,
         never prompts). Welcome Home is NOT named: its setup screen has no
         entry point, so no customer can turn it on. -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Lumina uses your location while you're using the app to read the name of the Wi-Fi network you're on, so it can tell when you're home and control your lights directly, and to set your controller's location so sunrise and sunset schedules turn on at the right time.</string>
    <!-- ITMS-90683: this key exists SOLELY because the geolocator plugin binary
         references the Always location API, and Apple's static scanner rejects
         the build (ITMS-90683) if a referenced API has no usage string. Lumina
         makes ONLY a When-In-Use (whileInUse) request in Dart and never asks for
         Always/background authorization — the copy is foreground-honest to match.
         Do NOT re-add the 'location' UIBackgroundMode: there is no background
         location capability. -->
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Lumina uses your location only while you're using the app, to read the name of the Wi-Fi network you're on and to set your controller's location for sunrise and sunset schedules. Lumina never uses your location in the background.</string>
    <!-- Background modes: declare ONLY what the binary actually implements.
         Apple 2.5.4 rejects an app that "declares support for a background
         mode but does not include functionality requiring that mode".

         `remote-notification` is justified: firebase_messaging ships and is
         registered in GeneratedPluginRegistrant.

         `fetch` and `processing` were REMOVED 2026-09-17, together with the
         BGTaskSchedulerPermittedIdentifiers array that held
         `com.nexgenled.lumina.sportscheck` and `.syncEventCheck`. Nothing
         implemented them:
           * their only plausible consumer is flutter_background_service, and
             kSportsBackgroundServiceEnabled is `false` in
             lib/features/sports_alerts/services/sports_background_service.dart
             — a deliberate kill-switch for this store release — so
             service.configure(...) never runs and nothing is ever scheduled;
           * neither identifier appeared anywhere in lib/ or ios/ (zero hits
             for BGTaskScheduler, sportscheck, syncEventCheck). They also
             carried the ANDROID package prefix com.nexgenled.lumina rather
             than the iOS bundle id com.nexgenled.command, and
             flutter_background_service_ios registers its own identifier
             regardless — so they matched nothing even in principle.

         RE-ENABLING: flipping kSportsBackgroundServiceEnabled back to true is
         already documented as a multi-step act (restore
         FOREGROUND_SERVICE_DATA_SYNC + the BackgroundService <service> in
         AndroidManifest.xml, complete the Play FGS declaration). Restore
         `fetch`/`processing` HERE in that same change, with identifiers that
         match what the plugin actually registers. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
	<key>NSCameraUsageDescription</key>
	<string>Lumina uses the camera when you choose to take a photo of your home for your dashboard and lighting previews, or a job-site photo during an installation.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Lumina uses the microphone only when you tap a mic button or press and hold the Lumina button to speak a request instead of typing it.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Lumina uses speech recognition to turn your spoken request into text.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Lumina lets you choose a photo of your home from your library to use on your dashboard and in lighting previews.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Lumina uses Bluetooth to find a new Nex-Gen lighting controller and connect it to your Wi-Fi during setup.</string>
    <!-- URL Scheme for Siri Shortcuts and deep linking -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.nexgenled.command</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>lumina</string>
            </array>
        </dict>
    </array>
    <!-- Siri Shortcuts user activity types -->
    <key>NSUserActivityTypes</key>
    <array>
        <string>com.nexgen.lumina.applyScene</string>
        <string>com.nexgen.lumina.powerOn</string>
        <string>com.nexgen.lumina.powerOff</string>
        <string>com.nexgen.lumina.setBrightness</string>
        <string>com.nexgen.lumina.setColor</string>
    </array>
</dict>
</plist>
