<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Lumina</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Lumina</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSBonjourServices</key>
	<array>
		<string>_wled._tcp</string>
		<string>_http._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Lumina scans your local network to find and control your Nex-Gen lighting controllers.</string>
    <!-- Location usage: required by iOS to read WiFi SSID for home-network
         detection, and to configure the Welcome Home geofence. -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Lumina uses your location to detect the WiFi network you are connected to (so it knows when you are on your home network) and to configure the Welcome Home geofence.</string>
    <!-- ITMS-90683: this key exists SOLELY because the geolocator plugin binary
         references the Always location API, and Apple's static scanner rejects
         the build (ITMS-90683) if a referenced API has no usage string. Lumina
         makes ONLY a When-In-Use (whileInUse) request in Dart and never asks for
         Always/background authorization — the copy is foreground-honest to match.
         Do NOT re-add the 'location' UIBackgroundMode: there is no background
         location capability. -->
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Lumina uses your location only while you are using the app — to detect your home WiFi network and set up the Welcome Home geofence. It does not track your location in the background.</string>
    <!-- Background modes: declare ONLY what the binary actually implements.
         Apple 2.5.4 rejects an app that "declares support for a background
         mode but does not include functionality requiring that mode".

         `remote-notification` is justified: firebase_messaging ships and is
         registered in GeneratedPluginRegistrant.

         `fetch` and `processing` were REMOVED 2026-09-17, together with the
         BGTaskSchedulerPermittedIdentifiers array that held
         `com.nexgenled.lumina.sportscheck` and `.syncEventCheck`. Nothing
         implemented them:
           * their only plausible consumer is flutter_background_service, and
             kSportsBackgroundServiceEnabled is `false` in
             lib/features/sports_alerts/services/sports_background_service.dart
             — a deliberate kill-switch for this store release — so
             service.configure(...) never runs and nothing is ever scheduled;
           * neither identifier appeared anywhere in lib/ or ios/ (zero hits
             for BGTaskScheduler, sportscheck, syncEventCheck). They also
             carried the ANDROID package prefix com.nexgenled.lumina rather
             than the iOS bundle id com.nexgenled.command, and
             flutter_background_service_ios registers its own identifier
             regardless — so they matched nothing even in principle.

         RE-ENABLING: flipping kSportsBackgroundServiceEnabled back to true is
         already documented as a multi-step act (restore
         FOREGROUND_SERVICE_DATA_SYNC + the BackgroundService <service> in
         AndroidManifest.xml, complete the Play FGS declaration). Restore
         `fetch`/`processing` HERE in that same change, with identifiers that
         match what the plugin actually registers. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
	<key>NSCameraUsageDescription</key>
	<string>Camera access is required for AR spatial mapping of your lights.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Microphone access enables voice-to-text control and audio-reactive lighting in Nex-Gen.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Lumina uses speech recognition to enable voice control of your lighting system.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Lumina needs access to your photo library to select a photo of your home for your lighting dashboard.</string>
	<key>NSPhotoLibraryAddOnlyUsageDescription</key>
	<string>Lumina needs permission to save lighting design photos to your library.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Nex-Gen uses Bluetooth to find and setup your lighting controller.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>Nex-Gen uses Bluetooth to pair with your lighting controller during setup.</string>
    <!-- URL Scheme for Siri Shortcuts and deep linking -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.nexgenled.command</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>lumina</string>
            </array>
        </dict>
    </array>
    <!-- Siri Shortcuts user activity types -->
    <key>NSUserActivityTypes</key>
    <array>
        <string>com.nexgen.lumina.applyScene</string>
        <string>com.nexgen.lumina.powerOn</string>
        <string>com.nexgen.lumina.powerOff</string>
        <string>com.nexgen.lumina.setBrightness</string>
        <string>com.nexgen.lumina.setColor</string>
    </array>
</dict>
</plist>
