<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.nexgenled.lumina">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <!-- ACCESS_BACKGROUND_LOCATION intentionally NOT declared. The geofence
       ("Welcome Home") runs in the main app isolate and starts no location
       foreground service (no AndroidSettings.foregroundNotificationConfig), so
       it only functions while the app is active — there is no genuine
       app-closed background-location capability to justify the permission.
       Geofencing uses foreground (whileInUse) location only. A true app-closed
       geofence is a later workstream. -->
  <!-- Foreground services are DISABLED for this release. The only FGS was the
       sports/sync background watch (flutter_background_service, dataSync type),
       now gated off in Dart (kSportsBackgroundServiceEnabled=false). Strip BOTH
       our declarations AND the plugin-injected copies from the merged manifest
       via tools:node="remove" so the app declares no foreground-service
       permission and Play requires no FGS declaration / demo video.
       FOREGROUND_SERVICE_LOCATION was likewise never declared (geolocator uses
       whileInUse location only). Re-add FOREGROUND_SERVICE +
       FOREGROUND_SERVICE_DATA_SYNC (and the BackgroundService <service> below)
       when the background watch is re-enabled. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
      tools:node="remove" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
      tools:node="remove" />
  <!-- RECEIVE_BOOT_COMPLETED is inert: flutter_background_service is configured
       autoStart:false / autoStartOnBoot:false, so its BootReceiver never
       restarts the service. Strip BOTH our declaration AND the plugin-injected
       one (flutter_background_service_android) from the merged manifest via
       tools:node="remove" (same mechanism as AD_ID below) so the Play
       permission declaration matches actual behavior. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"
      tools:node="remove" />
    <!-- Android 13+ nearby Wi‑Fi devices (for discovery without location) -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <!-- Bluetooth permissions for BLE provisioning (Improv) -->
    <!-- Pre-Android 12 legacy permissions (limited to API 30 and below) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Android 12+ precise BLE permissions -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Camera marked optional — only used for the house-photo upload and
         AR roofline preview, both of which gracefully no-op on devices
         without a camera. Tells Google Play the camera is not a hard
         requirement and unblocks the privacy-policy review. -->
    <uses-permission android:name="android.permission.CAMERA"
        android:required="false" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 13+ runtime notification permission (FCM + local notifications) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Advertising ID: Lumina does not use ads or ad-tracking. Explicitly
         remove the implicit AD_ID permission so Google Play's data-safety
         declaration matches reality. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <!-- Auto Backup DISABLED. Backup used to capture the app's SharedPreferences,
         including FlutterSecureStorage.xml — the Tink keyset used by
         flutter_secure_storage. That keyset is encrypted with a MasterKey that
         lives in the Android Keystore, which is device-bound and is NEVER
         backed up. Restoring the keyset onto a device without its matching key
         yields AEADBadTagException ("Signature/MAC verification failed"), which
         is what bricked 2.5.10+55 into a permanent dead splash on a restored
         install. There is little to lose: Lumina's real state (profile,
         controllers, properties, schedules) lives in Firebase and is restored
         by signing in, not by device backup.

         allowBackup="false" covers cloud backup on every API level. It does NOT
         cover Android 12+ device-to-device transfer, so dataExtractionRules
         closes that second path — see res/xml/data_extraction_rules.xml. -->
    <application
        android:label="Lumina"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="s"
        android:usesCleartextTraffic="true">
        <!-- Google Maps SDK for Android API key.

             S-2, Apple/Play submission audit 2026-09-17. google_maps_flutter
             is a dependency and two screens build GoogleMap widgets
             (features/geofence/geofence_setup_screen.dart and
             screens/commercial/fleet/FleetDashboardScreen.dart), but neither
             platform supplied a Maps key: iOS never called
             GMSServices.provideAPIKey() and this meta-data was absent. Without
             it the map renders a blank grey tile.

             Same platform-appropriate Firebase client key the Dart side
             already uses for Places (features/schedule/geocoding_service.dart
             reads DefaultFirebaseOptions.<platform>.apiKey); matches
             DefaultFirebaseOptions.android.apiKey in lib/firebase_options.dart.
             Firebase API keys are public client identifiers by design and
             already ship in the binary — this is not a new secret exposure.

             REQUIRES A CONSOLE-SIDE STEP THIS COMMIT CANNOT DO: "Maps SDK for
             Android" must be enabled on this key in Google Cloud Console, and
             the key wants an Android-app restriction pinned to
             com.nexgenled.lumina with BOTH the upload and Play App Signing
             SHA-1 fingerprints. Note this key doubles as the billable Places
             key, so it also wants a quota cap. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyB2VhrbVD1lBbs_b_JuCkjLa1Yh_AsbWJs"/>
        <activity
            android:name="com.nexgenled.lumina.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link handler for Lumina URL scheme -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="lumina"/>
            </intent-filter>
            <!-- App Shortcuts metadata -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts"/>
            <!-- Google Assistant App Actions -->
            <meta-data
                android:name="android.app.actions"
                android:resource="@xml/actions"/>
        </activity>
        <!-- Strip geolocator's location foreground service (our redundant copy
             AND the plugin-injected one) from the merged manifest. Lumina uses
             geolocator for FOREGROUND (whileInUse) location only — WLED/mDNS
             discovery + geofence setup while the app is open — and never starts
             the location FGS (no foregroundNotificationConfig). Removing the
             service keeps the shipped manifest honest (no location
             foregroundServiceType) and pairs with dropping
             FOREGROUND_SERVICE_LOCATION above. Foreground getPositionStream
             uses platform location APIs directly, not this service. -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            tools:node="remove" />
        <!-- Sports/sync background polling service DISABLED for this release —
             strip our copy AND the plugin-injected one from the merged manifest
             so no foreground service ships (pairs with the removed
             FOREGROUND_SERVICE* permissions above). -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            tools:node="remove" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
